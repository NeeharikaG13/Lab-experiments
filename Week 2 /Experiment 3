#include<stdio.h>
int main()
{
  float p,n,r,si;
  /* p is principal amount
     n is term duration
     r is rate of interest 
     si is simple interest */
  printf("\n Enter the principal amount in rupees");
  scanf("%f",&p);
  printf("\n Enter the term duration in months");
  scanf("%f",&n);
  printf("\n Enter the rate of interest");
  scanf("%f",&r);
  si=(p*n*r)/100;
  printf("\n Simple Interest is %f",si);
  return 0;
}
