#include<stdio.h>
int main()
{
  int i;
  long int k;
  short int s;
  unsigned int x;
  float fi;
  char ch;
  double d;
  long double ld;
  printf("\n Enter a Character");
  scanf("%c",&ch);
  printf("\n Enter a Integer");
  scanf("%d",&i);
  printf("\n Enter a Long integer");
  scanf("%ld",&k);
  printf("\n Enter a Short integer");
  scanf("%hd",&s);
  printf("\n Enter a Unsigned integer");
  scanf("%u",&x);
  printf("\n Enter a Float");
  scanf("%f",&fi);
  printf("\n Enter a Double");
  scanf("%lf",&d);
  printf("\n Enter a long double");
  scanf("%lf",&ld);
  printf("Integer is %d\t float is %f\t character is %c\t double is %lf\t long doubleis %lf\t",i,fi,ch,d,ld);
  printf("\n Long integer is %ld\t short integer is %hd\t unsigned integer is %u",k,s,x);
  return 0;
}
